+# ==========================================================
+# Protein Hunter v5 Configuration File
+# ==========================================================
+
+project:
+  name: ProteinHunter
+  version: "5.0"
+
+# ----------------------------------------------------------
+# Input / Output
+# ----------------------------------------------------------
+paths:
+
+  # Target protein FASTA
+  target_fasta: "./data/input/target.faa"
+
+  # FASTA files used to automatically build BLAST databases
+  positive_fasta: "./data/databases/positive.faa"
+
+  negative_fasta: "./data/databases/negative.faa"
+
+  # Optional genome annotation
+  gff: "./data/input/genome.gff"
+
+  # Output Excel
+  output_excel: "./data/output/ProteinHunter_results.xlsx"
+
+  # Cache directory
+  cache_dir: "./.cache"
+
+  # Log directory
+  log_dir: "./logs"
+
+
+# ----------------------------------------------------------
+# BLAST
+# ----------------------------------------------------------
+
+blast:
+
+  evalue: 1e-5
+
+  max_target_seqs: 10
+
+  threads: auto
+
+
+# ----------------------------------------------------------
+# Annotation
+# ----------------------------------------------------------
+
+annotation:
+
+  enable_cdd: true
+
+  enable_pfam: true
+
+  enable_alphafold: true
+
+  enable_uniprot: true
+
+  enable_gene_context: true
+
+  cdd_threads: 4
+
+  pfam_threads: 4
+
+  pfam_evalue_threshold: 1e-5
+
+  alphafold_threads: 4
+
+
+# ----------------------------------------------------------
+# Annotation targets by Excel sheet
+# ----------------------------------------------------------
+
+annotation_targets:
+
+  candidates:
+    gff: true
+    pfam: true
+    uniprot: true
+    alphafold: true
+
+  positive_all_sources:
+    gff: true
+    pfam: true
+    uniprot: true
+    alphafold: true
+
+  no_hit:
+    gff: true
+    pfam: false
+    uniprot: false
+    alphafold: false
+
+  negative_unmatched:
+    gff: true
+    pfam: false
+    uniprot: false
+    alphafold: false
+
+  negative_hit:
+    gff: true
+    pfam: false
+    uniprot: false
+    alphafold: false
+
+
