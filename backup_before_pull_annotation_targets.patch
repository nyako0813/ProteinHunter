+"""Tests for main.py command-line config handling."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from core.models import BlastHit, ProteinRecord
+from main import (
+    _build_classification_record_sheets,
+    _records_enabled_for_annotation,
+    build_arg_parser,
+)
+
+
+@dataclass
+class Target:
+    gff: bool = False
+    pfam: bool = False
+    uniprot: bool = False
+    alphafold: bool = False
+
+
+def make_hit(query_id: str, source: str) -> BlastHit:
+    """Create a small BLAST hit for main helper tests."""
+    return BlastHit(
+        query_id=query_id,
+        subject_id=f"{source}_subject",
+        percent_identity=90.0,
+        alignment_length=100,
+        evalue=1e-20,
+        bitscore=50.0,
+        source=source,
+    )
+
+
+def test_main_config_arg_defaults_to_config_yaml() -> None:
+    """No --config argument should keep the production config default."""
+    args = build_arg_parser().parse_args([])
+
+    assert args.config == "config.yaml"
+    assert args.check_only is False
+
+
+def test_main_config_arg_accepts_custom_config() -> None:
+    """--config should allow a custom YAML config path."""
+    args = build_arg_parser().parse_args(["--config", "config.demo.yaml"])
+
+    assert args.config == "config.demo.yaml"
+
+
+def test_main_check_only_arg_is_accepted() -> None:
+    """--check-only should enable validation-only mode."""
+    args = build_arg_parser().parse_args(["--check-only"])
+
+    assert args.check_only is True
+
+
+def test_main_check_only_arg_works_with_custom_config() -> None:
+    """--check-only should work together with --config."""
+    args = build_arg_parser().parse_args(
+        ["--config", "config.demo.yaml", "--check-only"]
+    )
+
+    assert args.config == "config.demo.yaml"
+    assert args.check_only is True
+
+
+def test_classification_record_sheets_are_built_from_blast_status() -> None:
+    """Main helpers should keep all expected classification sheets."""
+    positive_only = ProteinRecord(
+        protein_id="positive_only",
+        positive_hits=[make_hit("positive_only", "positive")],
+    )
+    mixed = ProteinRecord(
+        protein_id="mixed",
+        positive_hits=[make_hit("mixed", "positive")],
+        negative_hits=[make_hit("mixed", "negative")],
+    )
+    negative_only = ProteinRecord(
+        protein_id="negative_only",
+        negative_hits=[make_hit("negative_only", "negative")],
+    )
+    no_hit = ProteinRecord(protein_id="no_hit")
+    all_records = {
+        record.protein_id: record
+        for record in (positive_only, mixed, negative_only, no_hit)
+    }
+    candidates = {"positive_only": positive_only}
+
+    sheets = _build_classification_record_sheets(all_records, candidates)
+
+    assert set(sheets) == {
+        "Candidates",
+        "Positive_all_sources",
+        "Negative_unmatched",
+        "No_hit",
+        "Negative_hit",
+    }
+    assert list(sheets["Candidates"]) == ["positive_only"]
+    assert list(sheets["Positive_all_sources"]) == ["positive_only"]
+    assert list(sheets["Negative_unmatched"]) == ["negative_only"]
+    assert list(sheets["No_hit"]) == ["no_hit"]
+    assert list(sheets["Negative_hit"]) == ["mixed"]
+
+
+def test_annotation_target_selection_can_enable_no_hit_pfam() -> None:
+    """No_hit.pfam=true should select No_hit records for Pfam annotation."""
+    no_hit = ProteinRecord(protein_id="no_hit")
+    sheets = {
+        "Candidates": {},
+        "Positive_all_sources": {},
+        "No_hit": {"no_hit": no_hit},
+    }
+    targets = {
+        "candidates": Target(pfam=True),
+        "positive_all_sources": Target(pfam=True),
+        "no_hit": Target(gff=True, pfam=True),
+    }
+
+    selected = _records_enabled_for_annotation(sheets, targets, "pfam")
+
+    assert selected == {"no_hit": no_hit}
+
+
+def test_annotation_target_selection_skips_no_hit_pfam_by_default() -> None:
+    """No_hit.pfam=false should not select No_hit records."""
+    no_hit = ProteinRecord(protein_id="no_hit")
+    sheets = {"No_hit": {"no_hit": no_hit}}
+    targets = {"no_hit": Target(gff=True, pfam=False)}
+
+    assert _records_enabled_for_annotation(sheets, targets, "pfam") == {}
+
+
+def test_annotation_target_selection_deduplicates_candidates_and_positive_sheet() -> None:
+    """Shared candidate records should be annotated only once."""
+    shared = ProteinRecord(protein_id="shared")
+    sheets = {
+        "Candidates": {"shared": shared},
+        "Positive_all_sources": {"shared": shared},
+    }
+    targets = {
+        "candidates": Target(pfam=True),
+        "positive_all_sources": Target(pfam=True),
+    }
+
+    selected = _records_enabled_for_annotation(sheets, targets, "pfam")
+
+    assert selected == {"shared": shared}
